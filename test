import os
import re
import subprocess
import sys

# --- CONFIGURATION ---
USB_UUID = "08C2-2B4B"
MOUNT_POINT = "/media/usb"
USB_FSTYPE = "vfat"

def sanitize(name):
    return re.sub(r'[\\/*?:"<>|]', "", name).strip()

def mount_usb():
    os.makedirs(MOUNT_POINT, exist_ok=True)
    # Check if already mounted
    check = subprocess.run(["mountpoint", "-q", MOUNT_POINT])
    if check.returncode == 0:
        return True

    print(f"Mounting USB drive (UUID={USB_UUID})...")
    cmd = ["sudo", "mount", "-U", USB_UUID, MOUNT_POINT]
    # Add permissions flags for FAT32/exFAT so standard user can write files
    if USB_FSTYPE in ("vfat", "exfat"):
        uid = os.getuid()
        gid = os.getgid()
        cmd = ["sudo", "mount", "-t", USB_FSTYPE, "-o", f"uid={uid},gid={gid}", "-U", USB_UUID, MOUNT_POINT]

    res = subprocess.run(cmd)
    return res.returncode == 0

def unmount_usb():
    print("Syncing data and unmounting USB drive...")
    subprocess.run(["sync"])
    res = subprocess.run(["sudo", "umount", MOUNT_POINT])
    if res.returncode == 0:
        print("USB drive safely unmounted. You can remove it now.")
    else:
        print("Warning: Could not unmount USB drive. Make sure no terminal is inside /mnt/usb_music.")

def main():
    artist = input("Artist: ").strip()
    album = input("Album: ").strip()
    playlist_url = input("YouTube Playlist URL: ").strip()

    if not artist or not album or not playlist_url:
        print("Error: Artist, Album, and Playlist URL are all required.")
        sys.exit(1)

    if not mount_usb():
        print("Failed to mount USB drive. Check that it is plugged in and the UUID is correct.")
        sys.exit(1)

    try:
        clean_artist = sanitize(artist)
        clean_album = sanitize(album)
        output_dir = os.path.join(MOUNT_POINT, clean_artist, clean_album)
        os.makedirs(output_dir, exist_ok=True)

        # Output template: 01. Track Title.mp3
        output_template = os.path.join(output_dir, "%(playlist_index)02d. %(title)s.%(ext)s")

        yt_cmd = [
            "yt-dlp",
            "--yes-playlist",
            "-x",
            "--audio-format", "mp3",
            "--audio-quality", "0",
            "--embed-thumbnail",
            "--add-metadata",
            # Overwrite artist, album, and track number metadata cleanly
            "--parse-metadata", f"{artist}:%(meta_artist)s",
            "--parse-metadata", f"{album}:%(meta_album)s",
            "--parse-metadata", "%(playlist_index)s:%(meta_track)s",
            "-o", output_template,
            playlist_url
        ]

        print(f"\nDownloading '{album}' by {artist} to {output_dir}...\n")
        subprocess.run(yt_cmd, check=True)
        print("\nDownload and conversion complete!")

    except subprocess.CalledProcessError as e:
        print(f"\nyt-dlp encountered an error: {e}")
    finally:
        # Always unmount the USB drive, even if a download fails
        unmount_usb()

if __name__ == "__main__":
    main()
